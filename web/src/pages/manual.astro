---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';

// Printable manual: every docs page in sidebar order, as one book (cover, index, chapters).
// Source of public/manual-opencode.pdf (npm run manual:pdf). Kept out of search and robots.
const MANUAL_TITLE = 'Manual de OpenCode V2 y OpenSpec';
const OPENSPEC_GUIDE = 'https://openspec-ochre.vercel.app/';
const WEBDESPEGA = 'https://webdespega.com/';

// Same groups and order as the sidebar in astro.config.mjs. Keep both in sync.
type Group = { label: string; slugs: string[] } | { label: string; dir: string };
const GROUPS: Group[] = [
	{ label: 'Inicio', slugs: ['index', 'ejemplos'] },
	{ label: 'Ruta de Aprendizaje', slugs: ['ruta-aprendizaje'] },
	{ label: 'Guías', dir: 'guias' },
	{ label: 'Avanzado', dir: 'avanzado' },
	{ label: 'OpenCode + OpenSpec', dir: 'openspec' },
	{ label: 'Recursos', dir: 'recursos' },
];

const entries = await getCollection('docs');
const byId = new Map(entries.map((e) => [e.id, e]));
const collator = new Intl.Collator('es-ES');
const placed = new Map<string, string>();
const ordered: { group: string; entry: (typeof entries)[number] }[] = [];

for (const group of GROUPS) {
	const members =
		'slugs' in group
			? group.slugs.map((slug) => {
					const entry = byId.get(slug);
					if (!entry) throw new Error(`[manual] «${slug}» no existe en docs (grupo ${group.label})`);
					return entry;
				})
			: entries
					.filter((e) => (e.id === group.dir || e.id.startsWith(`${group.dir}/`)) && !e.data.sidebar?.hidden)
					.sort((a, b) => {
						const ao = a.data.sidebar?.order ?? Number.MAX_VALUE;
						const bo = b.data.sidebar?.order ?? Number.MAX_VALUE;
						return ao !== bo ? ao - bo : collator.compare(a.id, b.id);
					});
	for (const entry of members) {
		if (placed.has(entry.id)) throw new Error(`[manual] «${entry.id}» aparece en dos grupos`);
		placed.set(entry.id, group.label);
		ordered.push({ group: group.label, entry });
	}
}
// Every visible page must land in the manual exactly once, or the build fails.
const unplaced = entries.filter((e) => !placed.has(e.id) && !e.data.sidebar?.hidden).map((e) => e.id);
if (unplaced.length) throw new Error(`[manual] páginas fuera del orden del manual: ${unplaced.join(', ')}`);

const sections = await Promise.all(
	ordered.map(async ({ group, entry }, i) => ({
		group,
		number: String(i + 1).padStart(2, '0'),
		anchor: `manual-${entry.id.replace(/\//g, '-')}`,
		slug: entry.id,
		title: entry.data.title,
		description: entry.data.description,
		Content: (await render(entry)).Content,
	})),
);
const parts = GROUPS.map((g) => ({
	label: g.label,
	items: sections.filter((s) => s.group === g.label),
})).filter((p) => p.items.length > 0);

// Screenshots are produced by `npm run manual:shots`. Only the ones that exist are printed,
// so the page still builds before the first capture.
const shotModules = import.meta.glob('../assets/manual/*.png', { eager: true, import: 'default' });
const SHOTS = [
	{
		file: 'home.png',
		alt: 'Página de inicio de la web de OpenCode',
		caption: 'Página de inicio: punto de partida, con la introducción y los accesos principales.',
	},
	{
		file: 'sidebar-openspec.png',
		alt: 'Menú lateral con el grupo OpenCode + OpenSpec',
		caption: 'Menú lateral con el grupo «OpenCode + OpenSpec» desplegado.',
	},
	{
		file: 'flujo-openspec.png',
		alt: 'Página del flujo de trabajo de OpenSpec',
		caption: 'Flujo de trabajo de OpenSpec: explorar, proponer, implementar y archivar un cambio.',
	},
	{
		file: 'migracion-tabla.png',
		alt: 'Tabla de equivalencias de OpenCode V1 a V2',
		caption: 'Tabla de equivalencias de la guía de migración de V1 a V2.',
	},
	{
		file: 'pie-webdespega.png',
		alt: 'Pie de página con el crédito de webdespega',
		caption: 'Pie de página con el crédito de diseño y desarrollo.',
	},
];
const shots = SHOTS.flatMap((s) => {
	const meta = shotModules[`../assets/manual/${s.file}`] as ImageMetadata | undefined;
	return meta ? [{ ...s, meta }] : [];
});

const buildDate = new Intl.DateTimeFormat('es-ES', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'Europe/Madrid',
}).format(new Date());
---

<StarlightPage
	frontmatter={{
		title: MANUAL_TITLE,
		description: 'Todas las páginas de la web en un solo documento imprimible.',
		template: 'splash',
		pagefind: false,
		tableOfContents: false,
		prev: false,
		next: false,
		head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex' } }],
	}}
>
	<div class="manual" data-manual>
		<section class="cover" aria-labelledby="manual-portada" data-manual-cover>
			<div class="cover-art" aria-hidden="true"><span class="disc"></span><span class="ring"></span></div>
			<div class="cover-body">
				<p class="kicker">Formación interna del equipo</p>
				<h2 id="manual-portada" class="cover-title">{MANUAL_TITLE}</h2>
				<p class="cover-subtitle">
					Toda la web en un solo documento, en el mismo orden que el menú lateral. La versión en línea siempre
					es la más reciente.
				</p>
				<p class="cover-edition">Edición de {buildDate}</p>
				<aside class="guide-box" aria-label="Guía completa de OpenSpec">
					<p>Para el método completo de OpenSpec, consulta la <a href={OPENSPEC_GUIDE}>Guía completa de OpenSpec</a>: <strong>openspec-ochre.vercel.app</strong>.</p>
				</aside>
			</div>
			<p class="cover-footer">
				<span>Diseño y desarrollo: <a href={WEBDESPEGA}>webdespega.com</a></span>
				<span>Documento generado desde la web</span>
			</p>
		</section>

		<nav class="toc" aria-labelledby="manual-indice" data-manual-toc>
			<p class="kicker-dark">Contenido</p>
			<h2 id="manual-indice">Índice</h2>
			<hr class="rule" />
			{
				parts.map((part) => (
					<div class="part" data-manual-part={part.label}>
						<h3 class="part-title">{part.label}</h3>
						<ol>
							{part.items.map((s) => (
								<li>
									<span class="num">{s.number}</span>
									<span class="entry">
										<a href={`#${s.anchor}`}>{s.title}</a>
										{s.description && <span class="desc">{s.description}</span>}
									</span>
								</li>
							))}
						</ol>
					</div>
				))
			}
		</nav>

		{
			shots.length > 0 && (
				<section class="tour" id="asi-es-la-web" data-manual-tour aria-labelledby="asi-es-la-web-titulo">
					<p class="chapter-label">Vista previa</p>
					<h2 class="section-title" id="asi-es-la-web-titulo">Así es la web</h2>
					<hr class="rule" />
					<p>
						Capturas de la propia web, en escritorio y tema claro: la página de inicio, el menú lateral, el flujo
						de OpenSpec, una tabla de migración y el pie de página.
					</p>
					{shots.map((s) => (
						<figure class="shot">
							<img src={s.meta.src} width={s.meta.width} height={s.meta.height} alt={s.alt} />
							<figcaption>{s.caption}</figcaption>
						</figure>
					))}
				</section>
			)
		}

		{
			sections.map(({ anchor, slug, group, number, title, description, Content }) => (
				<section class="manual-section" id={anchor} data-manual-section data-manual-slug={slug} aria-labelledby={`${anchor}-titulo`}>
					<p class="chapter-label">Capítulo {number} · {group}</p>
					<h2 class="section-title" id={`${anchor}-titulo`}>{title}</h2>
					{description && <p class="lead">{description}</p>}
					<hr class="rule" />
					<Content />
				</section>
			))
		}
	</div>
</StarlightPage>

<style>
	/* Book look, scoped to /manual/: white paper on screen and in print, whatever the site theme. */
	.manual {
		--m-petrol: #0f3a44;
		--m-teal: #0e5f66;
		--m-teal-soft: #e6f2f2;
		--m-orange: #b45309;
		--m-orange-light: #f0a35e;
		--m-orange-soft: #fdf1e6;
		--m-ink: #1f2933;
		--m-muted: #52606d;
		--m-line: #d5dbe0;
		--m-heading: 'DM Sans Variable', 'DM Sans', system-ui, sans-serif;
		/* Light Starlight tokens inside the manual, so rendered markdown reads ink on paper. */
		--sl-color-white: var(--m-ink);
		--sl-color-gray-1: #24272f;
		--sl-color-gray-2: #353841;
		--sl-color-gray-3: var(--m-muted);
		--sl-color-gray-5: var(--m-line);
		--sl-color-gray-6: #eceef2;
		--sl-color-text: var(--m-ink);
		--sl-color-text-accent: var(--m-teal);
		--sl-color-accent: var(--m-teal);
		--sl-color-accent-high: var(--m-petrol);
		--sl-color-accent-low: var(--m-teal-soft);
		--sl-color-hairline: var(--m-line);
		--sl-color-hairline-light: var(--m-line);
		--sl-color-bg-inline-code: #eef1f4;
		background: #fff;
		color: var(--m-ink);
		padding: 0 1rem 2rem;
		border-radius: 0.5rem;
	}
	.manual :global(a) {
		color: var(--m-teal);
		overflow-wrap: anywhere;
	}

	/* Cover */
	.cover {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 36rem;
		margin: 0 -1rem;
		padding: 3rem 2rem 2rem;
		border-radius: 0.5rem 0.5rem 0 0;
		background: var(--m-petrol);
		color: #fff;
	}
	.cover-art .disc,
	.cover-art .ring {
		position: absolute;
		border-radius: 50%;
	}
	.cover-art .disc {
		width: 34rem;
		height: 34rem;
		top: -14rem;
		right: -8rem;
		background: #0f5764;
	}
	.cover-art .ring {
		width: 12rem;
		height: 12rem;
		top: 13rem;
		right: 9rem;
		border: 2px solid #d9792b;
	}
	.cover-body {
		position: relative;
		margin-top: 10rem;
	}
	.kicker,
	.kicker-dark,
	.chapter-label {
		margin: 0;
		font-family: var(--m-heading);
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}
	.kicker {
		color: var(--m-orange-light);
	}
	.kicker-dark,
	.chapter-label {
		color: var(--m-orange);
	}
	.cover-title {
		margin: 0.75rem 0 1rem;
		font-family: var(--m-heading);
		font-weight: 700;
		font-size: clamp(2.2rem, 8vw, 3.8rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: #fff;
	}
	.cover-subtitle {
		max-width: 34rem;
		color: #d7e6e8;
		font-size: 1.05rem;
	}
	.cover-edition {
		margin-top: 0.5rem;
		font-size: 0.9rem;
		color: #9cc3c7;
	}
	.guide-box {
		max-width: 34rem;
		margin: 2rem 0 0;
		padding: 1rem 1.25rem;
		border-left: 4px solid var(--m-orange-light);
		border-radius: 0 0.4rem 0.4rem 0;
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
	}
	.guide-box p {
		margin: 0;
	}
	.guide-box a {
		color: #fff;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.cover-footer {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		margin: 3rem 0 0;
		padding-top: 0.75rem;
		border-top: 1px solid #2c5560;
		font-size: 0.8rem;
		color: #c3d5d8;
	}
	.cover-footer a {
		color: #fff;
	}

	/* Chapter openers */
	.section-title {
		margin-top: 0.4rem;
		font-family: var(--m-heading);
		font-weight: 700;
		font-size: clamp(1.8rem, 5vw, 2.4rem);
		line-height: 1.15;
		color: var(--m-ink);
	}
	.lead {
		color: var(--m-muted);
		font-size: 1.1rem;
	}
	.rule {
		border: 0;
		border-top: 2px solid var(--m-teal);
		margin: 1.25rem 0 1.5rem;
	}
	.toc,
	.tour,
	.manual-section {
		margin-top: 3rem;
		padding-top: 2rem;
	}
	.manual :global(h2:not(.section-title):not(.cover-title):not(#manual-indice)),
	.manual :global(.sl-heading-wrapper.level-h2 h2) {
		font-family: var(--m-heading);
		font-weight: 700;
		color: var(--m-teal);
	}
	.manual :global(h3) {
		font-family: var(--m-heading);
		color: var(--m-ink);
	}

	/* Screenshots */
	.shot {
		margin: 1.5rem 0 2rem;
	}
	.shot img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--m-line);
		border-radius: 0.4rem;
	}
	.shot figcaption {
		margin-top: 0.5rem;
		font-size: 0.9rem;
		color: var(--m-muted);
	}

	/* Index */
	.part-title {
		margin: 1.5rem 0 0.25rem;
		font-size: 0.8rem !important;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--m-muted) !important;
	}
	.toc ol {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.toc li {
		display: flex;
		gap: 1rem;
		margin: 0;
		padding: 0.5rem 0;
		border-bottom: 1px dotted var(--m-line);
	}
	.toc .num {
		flex: 0 0 2rem;
		font-family: var(--m-heading);
		font-weight: 700;
		color: var(--m-orange);
	}
	.toc .entry {
		display: flex;
		flex-direction: column;
	}
	.toc .entry a {
		color: var(--m-ink);
		text-decoration: none;
	}
	.toc .desc {
		font-size: 0.82rem;
		color: var(--m-muted);
	}

	/* Tables: teal header row */
	.manual :global(table) {
		border-collapse: collapse;
		width: 100%;
	}
	.manual :global(table th) {
		background: var(--m-teal);
		color: #fff;
		border-color: var(--m-teal);
		text-align: left;
	}
	.manual :global(table td) {
		border-color: var(--m-line);
	}
	.manual :global(table th),
	.manual :global(table td) {
		padding: 0.45rem 0.7rem;
	}
	.manual :global(table tbody tr:nth-child(odd) td) {
		background: #f6f8f9;
	}
	.manual :global(table th code) {
		background: rgba(255, 255, 255, 0.15);
		color: #fff;
	}

	/* Asides: left-bordered boxes with a small-caps label */
	.manual :global(.starlight-aside) {
		border: 0;
		border-inline-start: 4px solid var(--m-teal);
		border-radius: 0 0.4rem 0.4rem 0;
		background: var(--m-teal-soft);
		color: var(--m-ink);
		padding: 0.9rem 1.1rem;
	}
	.manual :global(.starlight-aside--caution),
	.manual :global(.starlight-aside--danger) {
		border-inline-start-color: #d9792b;
		background: var(--m-orange-soft);
	}
	.manual :global(.starlight-aside__title) {
		font-family: var(--m-heading);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--m-teal);
	}
	.manual :global(.starlight-aside--caution .starlight-aside__title),
	.manual :global(.starlight-aside--danger .starlight-aside__title) {
		color: var(--m-orange);
	}
	.manual :global(.starlight-aside__icon),
	.manual :global(.sl-anchor-link) {
		display: none;
	}

	/* Code: dark rounded blocks. Long lines wrap instead of scrolling, so nothing is cut off on paper. */
	.manual :global(.expressive-code .frame) {
		--code-background: #1e2a33;
		border-radius: 0.5rem;
		overflow: hidden;
		box-shadow: none;
	}
	.manual :global(.expressive-code pre) {
		background: #1e2a33 !important;
		border: 0 !important;
		border-radius: 0.5rem;
		color: #e6edf3;
		overflow: visible;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.manual :global(.expressive-code pre code) {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.manual :global(.expressive-code .header) {
		background: #142029 !important;
		color: #c3d5d8;
		border: 0 !important;
	}
	.manual :global(.expressive-code .copy) {
		display: none;
	}
	.manual :global(.expressive-code span[style^='--']:not([class])) {
		color: var(--0, inherit) !important;
	}
	/* GFM task lists: a printed checklist needs no unlabeled form controls. */
	.manual :global(.task-list-item input[type='checkbox']) {
		display: none;
	}
	.manual :global(.task-list-item)::before {
		content: '☐ ';
	}

	/* Print: A4 with the cover bleeding edge to edge, side margins on the other pages. */
	@page {
		size: A4;
		margin: 16mm 0 18mm;
	}
	@page :first {
		margin: 0;
	}

	@media print {
		:global(header.header),
		:global(#starlight__sidebar),
		:global(.sidebar-pane),
		:global(site-search),
		:global(.mobile-preferences),
		:global(.right-sidebar-container),
		:global(.skip-link),
		:global(footer),
		:global(.content-panel:has(+ .content-panel .manual) h1),
		:global(.content-panel:has(+ .content-panel .manual)) {
			display: none !important;
		}
		:global(html),
		:global(body),
		:global(.main-frame),
		:global(.main-pane),
		:global(.content-panel),
		:global(.sl-container) {
			background: #fff !important;
			padding: 0 !important;
			margin: 0 !important;
			max-width: none !important;
			border: 0 !important;
		}
		.manual {
			padding: 0;
			border-radius: 0;
		}
		.toc,
		.tour,
		.manual-section {
			break-before: page;
			margin-top: 0;
			padding-top: 0;
			padding-inline: 16mm !important;
		}
		.cover {
			box-sizing: border-box;
			width: 210mm;
			height: 297mm;
			min-height: 0;
			margin: 0;
			padding: 0 20mm 22mm;
			border-radius: 0;
			-webkit-print-color-adjust: exact;
			print-color-adjust: exact;
		}
		.cover-body {
			margin-top: 100mm;
		}
		.cover-art .disc {
			width: 150mm;
			height: 150mm;
			top: -55mm;
			right: -28mm;
		}
		.cover-art .ring {
			display: none;
		}
		.cover-footer {
			margin-top: auto;
		}
		.toc li,
		.shot,
		.manual :global(tr),
		.manual :global(.starlight-aside),
		.manual :global(pre),
		.manual :global(figure),
		.manual :global(table) {
			break-inside: avoid;
		}
		.manual :global(h2),
		.manual :global(h3),
		.manual :global(.sl-heading-wrapper) {
			break-after: avoid;
		}
		/* Tabs (PowerShell / bash): print every panel, labelled by its tab. */
		.manual :global(starlight-tabs [role='tablist']) {
			display: none;
		}
		.manual :global(starlight-tabs [role='tabpanel']),
		.manual :global(starlight-tabs [role='tabpanel'][hidden]) {
			display: block !important;
		}
		.manual :global(starlight-tabs [role='tabpanel']::before) {
			content: attr(data-manual-tab);
			display: block;
			font-family: var(--sl-font-mono);
			font-size: var(--sl-text-sm);
			font-weight: 600;
		}
	}
</style>
